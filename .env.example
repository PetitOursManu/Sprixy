# Copy to .env and adjust.

# REQUIRED in production: 32 random bytes (base64 or hex) used to encrypt provider API keys.
# openssl rand -base64 32
SPRIXY_MASTER_KEY=

# Allow new users to sign up after the first (admin) account. Default: false.
SPRIXY_ALLOW_SIGNUP=false

# Set to true when served over HTTPS (Coolify, reverse proxy) so session cookies are Secure.
SPRIXY_SECURE_COOKIES=false

# Public URL (informational, used in docs/snippets).
SPRIXY_PUBLIC_URL=

# Server
PORT=3210
HOST=0.0.0.0
SPRIXY_DATA_DIR=./data
LOG_LEVEL=info

# Optional
# FFMPEG_PATH=/usr/bin/ffmpeg          # used to extract frames from generated videos
# SPRIXY_MAX_UPLOAD_MB=50
# SPRIXY_SESSION_DAYS=30
# SPRIXY_POLL_INTERVAL_MS=1500
# SPRIXY_JOB_TIMEOUT_MS=1800000
