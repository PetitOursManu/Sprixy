{
  "name": "@sprixy/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sprixy API server: projects, BYOK providers, generation jobs, processing, exports, REST + MCP",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
